{
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {"key": "Content-Type", "value": "application/xml; charset=utf-8"}
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {"key": "Content-Type", "value": "text/plain; charset=utf-8"}
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{"type": "host", "value": "www.psicogiuliamirabile.it"}],
      "destination": "https://psicogiuliamirabile.it/$1",
      "permanent": true
    }
  ]
}
